{
  "name": "dsh-inapp-browser",
  "version": "0.2.7",
  "description": "A shared interactive browser inside DeepSeek Harness and Better Sidebar: mouse, keyboard, screenshots and agent tools.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/browser.js",
    "src/cdp.js",
    "src/http.js",
    "src/native-cdp.js",
    "src/platform.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-better-sidebar",
    "deepseek-harness",
    "browser",
    "cdp"
  ],
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.19.1 <0.20.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  }
}
