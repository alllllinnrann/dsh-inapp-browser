{
  "name": "dsh-inapp-browser",
  "version": "0.2.5",
  "description": "A shared interactive browser inside DeepSeek Harness and Better Sidebar: mouse, keyboard, screenshots and agent tools.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "scripts/build.mjs",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-better-sidebar",
    "deepseek-harness",
    "browser",
    "cdp"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:host": "node tests/host-smoke.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "dsh-better-sidebar": ">=0.19.1 <0.20.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
